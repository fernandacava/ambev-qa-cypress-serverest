{
  "name": "ambev-qa-cypress-serverest",
  "version": "1.0.0",
  "private": true,
  "description": "Desafio técnico de QA com testes frontend e API do ServeRest usando Cypress e JavaScript.",
  "scripts": {
    "cy:open": "cypress open",
    "test": "npm run test:all",
    "test:all": "cypress run --browser chrome",
    "test:api": "cypress run --browser chrome --spec 'cypress/e2e/api/**/*.cy.js'",
    "test:frontend": "cypress run --browser chrome --spec 'cypress/e2e/frontend/**/*.cy.js'",
    "test:report": "npm run test:all && npm run report:merge && npm run report:generate",
    "report:merge": "mochawesome-merge cypress/reports/.jsons/*.json > cypress/reports/report.json",
    "report:generate": "marge cypress/reports/report.json --reportDir cypress/reports/html --inline",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "cypress": "^15.8.2",
    "eslint": "^9.39.1",
    "eslint-plugin-cypress": "^5.2.0",
    "globals": "^16.5.0",
    "mochawesome": "^7.1.4",
    "mochawesome-merge": "^5.0.0",
    "mochawesome-report-generator": "^6.3.2",
    "prettier": "^3.7.4"
  },
  "engines": {
    "node": ">=20"
  }
}
